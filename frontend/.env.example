# Copy this file to `.env.local` (git-ignored) and fill in values.
# `NEXT_PUBLIC_` vars are exposed to the client bundle.

# Base URL of the backend API (should end with /api)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Clerk auth — get keys from https://dashboard.clerk.com (Application → API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Cloudinary — used for browser-side unsigned image uploads on the New Post
# form. Create an unsigned upload preset in the Cloudinary dashboard
# (Settings → Upload → Upload presets → Add → Signing mode: Unsigned) and
# paste its name below. Leave BOTH blank to hide the image uploader
# gracefully; text posts still work.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
