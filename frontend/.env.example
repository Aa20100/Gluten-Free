# Copy this file to `.env.local` (git-ignored) and fill in values.
# `NEXT_PUBLIC_` vars are exposed to the client bundle.

# Base URL of the backend API (should end with /api)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Clerk auth — get keys from https://dashboard.clerk.com (Application → API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Image uploads: no frontend Cloudinary env vars anymore. Files are sent
# to POST /api/posts as multipart and the backend uploads them to
# Cloudinary using its own CLOUDINARY_* keys.
