# Copy this file to `.env` and fill in real values. Never commit `.env`.

# HTTP port the API listens on (defaults to 5000 if unset)
PORT=

# MongoDB connection string, e.g. mongodb://localhost:27017/safebite
MONGODB_URI=

# Clerk keys — same values as the frontend's .env.local. clerkMiddleware()
# needs both. CLERK_PUBLISHABLE_KEY is the same string as
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY on the frontend (`pk_test_…` / `pk_live_…`);
# CLERK_SECRET_KEY is the sk_… value.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Cloudinary — placeholders for future server-side use (signed uploads,
# server-initiated deletes, webhook signature verification). Frontend
# uploads today are unsigned + browser-direct and don't need these.
# Cloud name matches NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME on the frontend;
# API key/secret come from Cloudinary dashboard → Settings → Access Keys.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
